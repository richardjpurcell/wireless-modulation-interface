#encoding utf-8
DEF WMI_U5 U 0 40 Y Y 1 F N
F0 "U" 0 400 60 H V C CNN
F1 "WMI_U5" 0 -400 50 H V C CNN
DRAW
S -400 300 400 -300 0 1 10 f
X RESET_N 1 -600 200 200 R 40 40 1 1 P
X GND 2 -600 100 200 R 40 40 1 1 P
X MR_N 3 -600 0 200 R 40 40 1 1 P
X WDI 4 -600 -100 200 R 40 40 1 1 P
X VDD 5 -600 -200 200 R 40 40 1 1 P
ENDDRAW
ENDDEF
